# Alpaca Markets (free tier) -- https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Email alerts (Gmail SMTP)
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
