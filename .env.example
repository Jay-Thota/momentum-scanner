# Scoring thresholds
WATCHLIST_MIN_SCORE=4.0
BEAR_REGIME_MIN_SCORE=5.0
SHORT_INTEREST_MAX_PCT=15.0
DAYS_TO_COVER_MAX=7.0
MIN_PRICE=10.0
MIN_AVG_VOLUME=1000000
MIN_MARKET_CAP=2000000000
